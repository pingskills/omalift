#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
else
  echo "qmake6 or qmake is required to build omalift." >&2
  exit 1
fi

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

"$QMAKE" "$ROOT/omalift.pro" ${ONNXRUNTIME_PREFIX:+ONNXRUNTIME_PREFIX="$ONNXRUNTIME_PREFIX"}
make -j"$(nproc 2>/dev/null || echo 1)"

echo "Built $BUILD_DIR/omalift"
